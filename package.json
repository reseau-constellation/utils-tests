{
  "version": "2.1.4",
  "license": "AGPL-3.0-or-later",
  "name": "@constl/utils-tests",
  "author": "Julien Jean Malard-Adam",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "nettoyer": "rimraf dist",
    "compiler": "pnpm versioner && pnpm formatter && pnpm nettoyer && pnpm tspc -p tsconfig.json",
    "compiler:prod": "pnpm versioner && pnpm formatter && pnpm nettoyer && pnpm tspc -p tsconfig.build.json",
    "test:node": "pnpm compiler && pnpm aegir test -t node --cov -- --exit",
    "test:navig": "pnpm compiler && pnpm aegir test -t browser --cov",
    "test:électron-principal": "pnpm compiler && pnpm aegir test -t electron-main --cov",
    "test:électron-rendu": "pnpm compiler && pnpm aegir test -t electron-renderer --cov",
    "test": "pnpm test:node && pnpm test:navig",
    "formatter": "pnpm prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\" && pnpm eslint src",
    "publier": "pnpm test && pnpm compiler:prod && (git commit -a -m 'version' || true) && pnpm stage publish",
    "versioner": "pnpm genversion  --es6 --semi src/version.ts"
  },
  "watch": {
    "build": {
      "patterns": "./src/**/*",
      "extensions": [
        ".ts",
        ".tsx"
      ]
    },
    "postbuild": "./dist/**/*"
  },
  "devDependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@constl/bohr-db": "^2.2.10",
    "@eslint/js": "^10.0.1",
    "@libp2p/circuit-relay-v2": "^4.2.12",
    "@libp2p/crypto": "^5.1.23",
    "@libp2p/identify": "^4.1.13",
    "@libp2p/interface": "^3.3.0",
    "@libp2p/websockets": "^10.1.20",
    "@multiformats/multiaddr": "^13.0.3",
    "@multiformats/multiaddr-matcher": "^3.0.2",
    "@orbitdb/core-types": "^1.2.5",
    "@orbitdb/feed-db": "^1.4.2",
    "@types/crypto-js": "^4.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "aegir": "^47.2.0",
    "ajv": "^8.20.0",
    "buffer": "^6.0.3",
    "core-js": "^3.50.0",
    "electron": "^41.10.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.3.0",
    "execa": "^9.6.1",
    "mocha": "^11.8.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "progress-events": "^1.1.0",
    "source-map-support": "^0.5.21",
    "ts-patch": "^4.0.1",
    "tsconfig-paths": "^4.2.0",
    "tscpaths": "^0.0.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "typescript-transform-paths": "^3.5.6"
  },
  "dependencies": {
    "@helia/block-brokers": "^5.2.4",
    "@libp2p/gossipsub": "^15.0.23",
    "@libp2p/peer-id": "^6.0.15",
    "@libp2p/ping": "^3.1.12",
    "@libp2p/webrtc": "^6.0.30",
    "@orbitdb/core": "^3.0.2",
    "blockstore-core": "^6.1.3",
    "blockstore-fs": "^3.0.3",
    "blockstore-idb": "^3.0.2",
    "browserify-fs": "^1.0.0",
    "chokidar": "^5.0.0",
    "crypto-browserify": "^3.12.1",
    "events": "^3.3.0",
    "genversion": "^3.2.0",
    "helia": "6.1.4",
    "libp2p": "^3.3.9",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "rimraf": "^6.1.3",
    "stream-browserify": "^3.0.0",
    "uint8arrays": "^5.1.1",
